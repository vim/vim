// https://www.hiascend.com/doc_center/source/en/CANNCommunityEdition/900/programug/Ascendcopdevg/atlas_ascendc_10_0014.html
// https://www.hiascend.com/doc_center/source/en/CANNCommunityEdition/900/programug/Ascendcopdevg/atlas_ascendc_10_10053.html
// https://www.hiascend.com/doc_center/source/en/CANNCommunityEdition/900/programug/Ascendcopdevg/atlas_ascendc_10_10054.html
#include "kernel_operator.h"
#include <cstdint>

__simt_callee__ inline int simt_helper(int value)
{
    return value;
}

__simd_callee__ inline int simd_helper(int value)
{
    return value;
}

__simt_vf__ __launch_bounds__(256) inline void simt_function(
        __gm__ float *input, __ubuf__ float *output)
{
    output[threadIdx.x] = input[threadIdx.x];
    simt_helper(0);
}

__simd_vf__ inline void simd_function(__ubuf__ float *input,
        __ubuf__ float *output)
{
    output[0] = input[0];
    simd_helper(0);
}

__global__ __aicore__ void kernel(__gm__ float *input)
{
    __ubuf__ float local[256];
    __cbuf__ float l1[256];
    __ca__ float l0a[256];
    __cb__ float l0b[256];
    __cc__ float l0c[256];
    __fbuf__ float fixpipe[256];
    __ssbuf__ float scratch[256];
    asc_vf_call<simt_function>(dim3(256), input, local);
    asc_vf_call<simd_function>(local, local);
}

extern "C" __global__ __vector__ __aicore__ void vector_kernel(__gm__ float *input)
{
}

extern __global__ __aicpu__ uint32_t aicpu_kernel(void *args);
__global__ __cube__ void cube_kernel(__gm__ float *input)
{
}

__mix__(1, 2) __global__ void mixed_kernel()
{
}

__schedmode__(1) __global__ __mix__(1, 2) void scheduled_kernel()
{
}

__aicore__ __inline__ void device_inline()
{
}
